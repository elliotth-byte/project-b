{
  "appId": "com.panopticon.app",
  "appName": "Panopticon",
  "webDir": "native-shell",
  "server": {
    "url": "https://project-b-pink.vercel.app",
    "cleartext": false,
    "errorPath": "offline.html"
  },
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#05010f"
  },
  "android": {
    "backgroundColor": "#05010f"
  },
  "plugins": {
    "FirebaseMessaging": {
      "presentationOptions": ["badge", "sound", "alert"]
    }
  },
  "experimental": {
    "ios": {
      "spm": {
        "packageOptions": {
          "@capacitor-firebase/messaging": {
            "symlink": true
          }
        }
      }
    }
  }
}
