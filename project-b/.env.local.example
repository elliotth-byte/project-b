# Copy this file to .env.local and fill in your own values.

# Find both of these in Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Project Settings -> API -> service_role key. NEVER prefix this with
# NEXT_PUBLIC_ — it must never reach the browser. Used only by the cron
# routes and the phase-advance endpoint (see pages/api/).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# GroupMe bot: create one at https://dev.groupme.com/bots (pick the group
# this game should post updates into), then paste its Bot ID here. Do NOT
# prefix with NEXT_PUBLIC_ — see pages/api/post-to-groupme.js for why.
GROUPME_BOT_ID=your-groupme-bot-id

# A random string (16+ characters) of your choosing. Vercel automatically
# sends this back as a Bearer token when it triggers your cron routes —
# see pages/api/cron/*.js.
CRON_SECRET=choose-a-long-random-string

# Slack incoming webhook URL (ported from the standalone Traitors app —
# see pages/api/post-to-slack.js, pages/api/cron/post-scheduled.js). Do
# NOT prefix with NEXT_PUBLIC_ — this must never reach the browser.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url

# Stereo Types' Spotify integration (host-only — see lib/spotify/auth.js).
# Create an app at https://developer.spotify.com/dashboard, then add
# ${your-app-origin}/stereo-types-spotify-callback as a Redirect URI
# there (exact match required, and Spotify requires either https or the
# literal loopback IP 127.0.0.1 for local dev — plain http://localhost
# is not accepted). PKCE only — there's no client secret to set here.
NEXT_PUBLIC_SPOTIFY_CLIENT_ID=your-spotify-client-id
