# Copy this file to .env.local and fill in your own values.

# Find both of these in Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Project Settings -> API -> service_role key. NEVER prefix this with
# NEXT_PUBLIC_ — it must never reach the browser. Used only by the cron
# routes and the phase-advance endpoint (see pages/api/).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# GroupMe bot: create one at https://dev.groupme.com/bots (pick the group
# this game should post updates into), then paste its Bot ID here. Do NOT
# prefix with NEXT_PUBLIC_ — see pages/api/post-to-groupme.js for why.
GROUPME_BOT_ID=your-groupme-bot-id

# A random string (16+ characters) of your choosing. Vercel automatically
# sends this back as a Bearer token when it triggers your cron routes —
# see pages/api/cron/*.js.
CRON_SECRET=choose-a-long-random-string
